    description: "SettingPanel \u203A ContentArea/Page_Gameplay/Viewport/Content/Row_Hint/Hint\u3000|\u3000\u6765\u6E90\uFF1ASettingLocalizationConfig"
    chineseSimplified: "\u5176\u4F59\u6E38\u620F\u6027\u8BBE\u7F6E\u9879\u5C06\u5728\u540E\u7EED\u7248\u672C\u4E2D\u52A0\u5165\n\uFF08\u5C4F\u5E55\u9707\u52A8\u3001\u4F24\u5BB3\u6570\u5B57\u7B49\uFF09"
    chineseTraditional: "\u5176\u9918\u904A\u6232\u6027\u8A2D\u5B9A\u9805\u5C07\u5728\u5F8C\u7E8C\u7248\u672C\u4E2D\u52A0\u5165\n\uFF08\u87A2\u5E55\u9707\u52D5\u3001\u50B7\u5BB3\u6578\u5B57\u7B49\uFF09"
    english: 'More gameplay settings will be added in future versions.

      (Screen
      shake, damage numbers, etc.)'
    japanese: "\u305D\u306E\u4ED6\u306E\u30B2\u30FC\u30E0\u30D7\u30EC\u30A4\u8A2D\u5B9A\u306F\u4ECA\u5F8C\u306E\u30D0\u30FC\u30B8\u30E7\u30F3\u3067\u8FFD\u52A0\u3055\u308C\u307E\u3059\n\uFF08\u753B\u9762\u632F\u52D5\u3001\u30C0\u30E1\u30FC\u30B8\u8868\u793A\u306A\u3069\uFF09"
    korean: "\uB098\uBA38\uC9C0 \uAC8C\uC784\uD50C\uB808\uC774 \uC124\uC815\uC740
      \uC774\uD6C4 \uBC84\uC804\uC5D0\uC11C \uCD94\uAC00\uB429\uB2C8\uB2E4\n(\uD654\uBA74
      \uD754\uB4E4\uB9BC, \uB370\uBBF8\uC9C0 \uC22B\uC790 \uB4F1)"
