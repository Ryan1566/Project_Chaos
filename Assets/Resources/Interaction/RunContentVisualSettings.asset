  receivedText:
    zhCN: "\u7269\u54C1\u5DF2\u52A0\u5165\u5C40\u5185\u80CC\u5305\u3002"
    enUS: Added to your run bag.
    zhTW: "\u7269\u54C1\u5DF2\u52A0\u5165\u5C40\u5167\u80CC\u5305\u3002"
    jaJP: "\u63A2\u7D22\u9784\u306B\u5165\u308C\u305F\u3002"
    koKR: "\uC6D0\uC815 \uAC00\uBC29\uC5D0 \uCD94\uAC00\uD588\uC2B5\uB2C8\uB2E4."
  npcHint:
    zhCN: "\u6BCF\u4F4D\u533B\u8005\u63D0\u4F9B\u4E00\u4EFD\u8865\u7ED9\uFF0C\u9009\u62E9\u540E\u4E0D\u80FD\u66F4\u6362\u3002"
    enUS: Choose one supply from this healer.
    zhTW: "\u6BCF\u4F4D\u91AB\u8005\u63D0\u4F9B\u4E00\u4EFD\u88DC\u7D66\uFF0C\u9078\u64C7\u5F8C\u4E0D\u80FD\u66F4\u63DB\u3002"
    jaJP: "\u3053\u306E\u533B\u5E2B\u304B\u3089\u88DC\u7D66\u3092\u4E00\u3064\u9078\u3079\u308B\u3002"
    koKR: "\uC758\uC6D0\uB9C8\uB2E4 \uBCF4\uAE09\uD488 \uD558\uB098\uB97C \uC120\uD0DD\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  lootHint:
    zhCN: "\u672A\u9886\u5185\u5BB9\u4EC5\u5728\u672C\u56FE\u4FDD\u7559\uFF1B\u5207\u56FE\u4E0D\u81EA\u52A8\u5E26\u51FA\uFF0C\u8BF7\u53CA\u65F6\u6574\u7406\u80CC\u5305\u3002"
    enUS: Unclaimed contents remain on this map only. Claim them before moving on.
    zhTW: "\u672A\u9818\u5167\u5BB9\u50C5\u5728\u672C\u5716\u4FDD\u7559\uFF1B\u5207\u5716\u4E0D\u81EA\u52D5\u5E36\u51FA\uFF0C\u8ACB\u53CA\u6642\u6574\u7406\u80CC\u5305\u3002"
    jaJP: "\u672A\u53D6\u5F97\u306E\u54C1\u306F\u3053\u306E\u5730\u56F3\u306B\u306E\u307F\u6B8B\u308B\u3002\u79FB\u52D5\u524D\u306B\u9784\u3092\u6574\u7406\u3057\u3066\u53D7\u3051\u53D6\u308D\u3046\u3002"
    koKR: "\uBBF8\uC218\uB839 \uBB3C\uD488\uC740 \uD604\uC7AC \uC9C0\uB3C4\uC5D0\uB9CC
      \uB0A8\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C \uC9C0\uB3C4\uB85C \uAC00\uAE30 \uC804\uC5D0
      \uBC1B\uC73C\uC138\uC694."
  completedText:
    zhCN: "\u5DF2\u7ED3\u675F"
    enUS: Unavailable
    zhTW: "\u5DF2\u7D50\u675F"
    jaJP: "\u7D42\u4E86"
