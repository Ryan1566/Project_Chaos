  definitions:
  - id: traveller
    kind: 0
    name:
      zhCN: "\u884C\u811A\u533B\u8005"
      enUS: Travelling Healer
      zhTW: "\u884C\u8173\u91AB\u8005"
      jaJP: "\u65C5\u306E\u533B\u5E2B"
      koKR: "\uB5A0\uB3CC\uC774 \uC758\uC6D0"
    body:
      zhCN: "\u4E71\u4E16\u884C\u8DEF\u4E0D\u6613\u3002\u6211\u8FD8\u6709\u4E9B\u8865\u7ED9\uFF0C\u4F60\u53EF\u4EE5\u4ECE\u4E2D\u9009\u4E00\u4EFD\u3002\u836F\u6750\u53EF\u7528\u4E8E\u7597\u4F24\uFF0C\u5E72\u7CAE\u80FD\u6682\u65F6\u63D0\u9AD8\u751F\u547D\u4E0A\u9650\u3002\u4FDD\u91CD\uFF01"
      enUS: 'These roads are dangerous. Take one of my supplies: medicine for wounds,
        or rations for a temporary health boost. Travel safely!'
      zhTW: "\u4E82\u4E16\u884C\u8DEF\u4E0D\u6613\u3002\u6211\u9084\u6709\u4E9B\u88DC\u7D66\uFF0C\u4F60\u53EF\u4EE5\u5F9E\u4E2D\u9078\u4E00\u4EFD\u3002\u85E5\u6750\u53EF\u7528\u65BC\u7642\u50B7\uFF0C\u4E7E\u7CE7\u80FD\u66AB\u6642\u63D0\u9AD8\u751F\u547D\u4E0A\u9650\u3002\u4FDD\u91CD\uFF01"
      jaJP: "\u5371\u967A\u306A\u65C5\u8DEF\u3060\u3002\u85AC\u304B\u643A\u884C\u98DF\u3092\u4E00\u3064\u9078\u3093\u3067\u304F\u308C\u3002\u85AC\u306F\u6CBB\u7642\u306B\u3001\u643A\u884C\u98DF\u306F\u4E00\u6642\u7684\u306A\u4F53\u529B\u5F37\u5316\u306B\u4F7F\u3048\u308B\u3002\u6C17\u3092\u3064\u3051\u3066\u3002"
      koKR: "\uD5D8\uD55C \uAE38\uC774\uAD70\uC694. \uC57D\uC7AC\uB098 \uC2DD\uB7C9
        \uC911 \uD558\uB098\uB97C \uAC00\uC838\uAC00\uC138\uC694. \uC57D\uC7AC\uB294
        \uCE58\uB8CC\uC5D0, \uC2DD\uB7C9\uC740 \uC77C\uC2DC\uC801\uC778 \uCD5C\uB300
        \uCCB4\uB825 \uC99D\uAC00\uC5D0 \uC4F0\uC785\uB2C8\uB2E4. \uC870\uC2EC\uD558\uC138\uC694!"
    rewards:
    - itemId: 1
      minCount: 1
      maxCount: 1
      label:
        zhCN: 
        enUS: 
        zhTW: 
        jaJP: 
        koKR: 
    - itemId: 5
      minCount: 1
      maxCount: 1
      label:
        zhCN: 
        enUS: 
        zhTW: 
        jaJP: 
        koKR: 
    quest:
      enabled: 1
      id: healer_gather_herbs
      targetContentId: herbs
      title:
        zhCN: "\u6CBF\u9014\u91C7\u836F"
        enUS: Herbs Along the Road
        zhTW: "\u6CBF\u9014\u63A1\u85E5"
        jaJP: "\u9053\u4E2D\u306E\u85AC\u8349"
        koKR: "\uAE38 \uC704\uC758 \uC57D\uCD08"
      description:
        zhCN: "\u8BF7\u91C7\u96C6\u4E00\u5904\u91CE\u751F\u836F\u8349\uFF0C\u518D\u5411\u4EFB\u610F\u884C\u811A\u533B\u8005\u590D\u547D\u3002\u63A5\u53D6\u540E\u6210\u529F\u91C7\u96C6\u624D\u8BA1\u6570\uFF0C\u4E09\u56FE\u5185\u6709\u6548\u3002"
        enUS: Gather one wild herb patch after accepting, then report to any travelling
          healer. Progress lasts this expedition.
        zhTW: "\u8ACB\u63A1\u96C6\u4E00\u8655\u91CE\u751F\u85E5\u8349\uFF0C\u518D\u5411\u4EFB\u610F\u884C\u8173\u91AB\u8005\u5FA9\u547D\u3002\u63A5\u53D6\u5F8C\u6210\u529F\u63A1\u96C6\u624D\u8A08\u6578\uFF0C\u4E09\u5716\u5167\u6709\u6548\u3002"
        jaJP: "\u53D7\u6CE8\u5F8C\u306B\u91CE\u751F\u306E\u85AC\u8349\u3092\u4E00\u304B\u6240\u63A1\u53D6\u3057\u3001\u65C5\u306E\u533B\u5E2B\u306B\u5831\u544A\u3057\u3088\u3046\u3002\u9032\u6357\u306F\u4ECA\u56DE\u306E\u63A2\u7D22\u4E2D\u306E\u307F\u6709\u52B9\u3002"
        koKR: "\uC218\uB77D \uD6C4 \uC57C\uC0DD \uC57D\uCD08 \uD55C \uACF3\uC744
          \uCC44\uC9D1\uD558\uACE0 \uB5A0\uB3CC\uC774 \uC758\uC6D0\uC5D0\uAC8C \uBCF4\uACE0\uD558\uC138\uC694.
          \uC9C4\uD589\uB3C4\uB294 \uC774\uBC88 \uC6D0\uC815 \uB3D9\uC548 \uC720\uC9C0\uB429\uB2C8\uB2E4."
      requiredCount: 1
      rewardItemId: 1
      rewardCount: 1
  - id: chest
    kind: 1
    name:
      zhCN: "\u9057\u7559\u8865\u7ED9\u7BB1"
      enUS: Abandoned Supply Chest
      zhTW: "\u907A\u7559\u88DC\u7D66\u7BB1"
      jaJP: "\u6B8B\u3055\u308C\u305F\u88DC\u7D66\u7BB1"
      koKR: "\uB0A8\uACA8\uC9C4 \uBCF4\uAE09 \uC0C1\uC790"
    body:
      zhCN: "\u7BB1\u4E2D\u7559\u6709\u836F\u6750\u3001\u77FF\u6599\u548C\u5E72\u7CAE\u3002\u53EF\u4EE5\u5206\u522B\u9886\u53D6\uFF1B\u80CC\u5305\u88C5\u4E0D\u4E0B\u65F6\uFF0C\u672A\u9886\u53D6\u7684\u7269\u54C1\u4F1A\u7559\u5728\u7BB1\u4E2D\u3002"
      enUS: Medicine, ore and rations remain inside. Claim each separately; unclaimed
        items stay here if your bag is full.
      zhTW: "\u7BB1\u4E2D\u7559\u6709\u85E5\u6750\u3001\u7926\u6599\u548C\u4E7E\u7CE7\u3002\u53EF\u4EE5\u5206\u5225\u9818\u53D6\uFF1B\u80CC\u5305\u88DD\u4E0D\u4E0B\u6642\uFF0C\u672A\u9818\u53D6\u7684\u7269\u54C1\u6703\u7559\u5728\u7BB1\u4E2D\u3002"
      jaJP: "\u85AC\u3001\u9271\u77F3\u3001\u643A\u884C\u98DF\u304C\u5165\u3063\u3066\u3044\u308B\u3002\u4E00\u3064\u305A\u3064\u53D7\u3051\u53D6\u308C\u308B\u3002\u9784\u304C\u6E80\u676F\u306A\u3089\u672A\u53D6\u5F97\u306E\u54C1\u306F\u7BB1\u306B\u6B8B\u308B\u3002"
      koKR: "\uC57D\uC7AC, \uAD11\uC11D, \uC2DD\uB7C9\uC774 \uB4E4\uC5B4 \uC788\uC2B5\uB2C8\uB2E4.
        \uB530\uB85C \uBC1B\uC744 \uC218 \uC788\uC73C\uBA70 \uAC00\uBC29\uC774 \uAC00\uB4DD
        \uCC28\uBA74 \uB0A8\uC740 \uBB3C\uD488\uC740 \uC0C1\uC790\uC5D0 \uBCF4\uAD00\uB429\uB2C8\uB2E4."
    rewards:
    - itemId: 1
      minCount: 1
      maxCount: 2
      label:
        zhCN: 
        enUS: 
        zhTW: 
        jaJP: 
        koKR: 
    - itemId: 7
