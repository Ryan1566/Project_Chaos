    enUS: Back
    zhTW: "\u8FD4\u56DE"
    jaJP: "\u623B\u308B"
    koKR: "\uB4A4\uB85C"
  taxTitle:
    zhCN: "\u7A0E\u6536\u8BF4\u660E"
    enUS: Tax Information
    zhTW: "\u7A05\u6536\u8AAA\u660E"
    jaJP: "\u5FB4\u7A0E\u306E\u6848\u5185"
    koKR: "\uC138\uAE08 \uC548\uB0B4"
  taxBody:
    zhCN: "\u7A0E\u6536\u5236\u5EA6\u5C06\u5728\u540E\u7EED\u8BBE\u8BA1\u3002\u672C\u9875\u4EC5\u8BF4\u660E\u9884\u7559\u7528\u9014\uFF0C\u4E0D\u5F81\u7A0E\u3001\u4E0D\u53D1\u653E\u6536\u76CA\uFF0C\u4E5F\u4E0D\u6539\u53D8\u8D44\u6E90\u3002"
    enUS: Tax rules will be designed later. This information page collects no taxes,
      grants no income and changes no resources.
    zhTW: "\u7A05\u6536\u5236\u5EA6\u5C07\u5728\u5F8C\u7E8C\u8A2D\u8A08\u3002\u672C\u9801\u50C5\u8AAA\u660E\u9810\u7559\u7528\u9014\uFF0C\u4E0D\u5FB5\u7A05\u3001\u4E0D\u767C\u653E\u6536\u76CA\uFF0C\u4E5F\u4E0D\u6539\u8B8A\u8CC7\u6E90\u3002"
    jaJP: "\u5FB4\u7A0E\u5236\u5EA6\u306F\u4ECA\u5F8C\u8A2D\u8A08\u3055\u308C\u307E\u3059\u3002\u3053\u306E\u6848\u5185\u3067\u306F\u5FB4\u7A0E\u3084\u53CE\u5165\u306E\u4ED8\u4E0E\u3001\u8CC7\u6E90\u306E\u5909\u66F4\u306F\u884C\u3044\u307E\u305B\u3093\u3002"
    koKR: "\uC138\uAE08 \uC81C\uB3C4\uB294 \uCD94\uD6C4 \uC124\uACC4\uB429\uB2C8\uB2E4.
      \uC774 \uC548\uB0B4\uC5D0\uC11C\uB294 \uC138\uAE08\uC744 \uAC77\uAC70\uB098
      \uC218\uC785\uC744 \uC9C0\uAE09\uD558\uAC70\uB098 \uC790\uC6D0\uC744 \uBCC0\uACBD\uD558\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4."
