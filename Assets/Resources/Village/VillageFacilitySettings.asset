  officeTitle:
    zhCN: "\u529E\u4E8B\u5355\u4F4D"
    enUS: Administrative Office
    zhTW: "\u8FA6\u4E8B\u55AE\u4F4D"
    jaJP: "\u57F7\u52D9\u6240"
    koKR: "\uC9D1\uBB34\uC18C"
  officeBody:
    zhCN: "\u5728\u6B64\u5904\u7406\u90E1\u53BF\u6307\u6D3E\u4E8B\u52A1\u3001\u884C\u653F\u4E8B\u4EF6\u3001\u9884\u8BBE\u4EFB\u52A1\u548C\u7A81\u53D1\u4EFB\u52A1\uFF0C\u8FDB\u884C\u4EA4\u6613\u5E76\u67E5\u770B\u7A0E\u6536\u8BF4\u660E\u3002\u7A0E\u6536\u89C4\u5219\u5C1A\u672A\u5F00\u653E\u3002"
    enUS: Handle county assignments, administrative events, preset tasks and emergencies;
      trade and view tax information. Tax rules are not available yet.
    zhTW: "\u5728\u6B64\u8655\u7406\u90E1\u7E23\u6307\u6D3E\u4E8B\u52D9\u3001\u884C\u653F\u4E8B\u4EF6\u3001\u9810\u8A2D\u4EFB\u52D9\u548C\u7A81\u767C\u4EFB\u52D9\uFF0C\u9032\u884C\u4EA4\u6613\u4E26\u67E5\u770B\u7A05\u6536\u8AAA\u660E\u3002\u7A05\u6536\u898F\u5247\u5C1A\u672A\u958B\u653E\u3002"
    jaJP: "\u90E1\u770C\u306E\u6307\u4EE4\u3001\u884C\u653F\u4E8B\u4EF6\u3001\u65E2\u5B9A\u4EFB\u52D9\u3001\u7A81\u767A\u4EFB\u52D9\u3092\u6271\u3044\u3001\u53D6\u5F15\u3068\u5FB4\u7A0E\u306E\u6848\u5185\u3092\u5229\u7528\u3067\u304D\u307E\u3059\u3002\u5FB4\u7A0E\u5236\u5EA6\u306F\u672A\u5B9F\u88C5\u3067\u3059\u3002"
    koKR: "\uC0C1\uAE09 \uC9C0\uC2DC, \uD589\uC815 \uC0AC\uAC74, \uC0AC\uC804 \uC784\uBB34\uC640
      \uB3CC\uBC1C \uC784\uBB34\uB97C \uCC98\uB9AC\uD558\uACE0 \uAC70\uB798\uC640
      \uC138\uAE08 \uC548\uB0B4\uB97C \uC774\uC6A9\uD569\uB2C8\uB2E4. \uC138\uAE08
      \uC81C\uB3C4\uB294 \uC544\uC9C1 \uC774\uC6A9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  tasksLabel:
    zhCN: "\u4EFB\u52A1\u4E0E\u4E8B\u4EF6"
    enUS: Tasks & Events
    zhTW: "\u4EFB\u52D9\u8207\u4E8B\u4EF6"
    jaJP: "\u4EFB\u52D9\u3068\u51FA\u6765\u4E8B"
    koKR: "\uC784\uBB34\uC640 \uC0AC\uAC74"
  tasksEmptyBody:
    zhCN: "\u5F53\u524D\u6CA1\u6709\u5F85\u5904\u7406\u4E8B\u4EF6\u3002\u4E8B\u4EF6\u4ECD\u6309\u65E2\u6709\u6761\u4EF6\u4E0E\u8FD4\u4E61\u6D41\u7A0B\u51FA\u73B0\uFF1B\u65B0\u7684\u4EFB\u52A1\u89C4\u5219\u5C06\u5728\u540E\u7EED\u8BBE\u8BA1\u3002"
    enUS: There are no pending events. Events keep their existing conditions and
      return-to-village flow; new task rules will be designed later.
    zhTW: "\u76EE\u524D\u6C92\u6709\u5F85\u8655\u7406\u4E8B\u4EF6\u3002\u4E8B\u4EF6\u4ECD\u6309\u65E2\u6709\u689D\u4EF6\u8207\u8FD4\u9109\u6D41\u7A0B\u51FA\u73FE\uFF1B\u65B0\u7684\u4EFB\u52D9\u898F\u5247\u5C07\u5728\u5F8C\u7E8C\u8A2D\u8A08\u3002"
    jaJP: "\u73FE\u5728\u3001\u672A\u51E6\u7406\u306E\u51FA\u6765\u4E8B\u306F\u3042\u308A\u307E\u305B\u3093\u3002\u65E2\u5B58\u306E\u6761\u4EF6\u3068\u5E30\u9084\u6642\u306E\u6D41\u308C\u3092\u4F7F\u7528\u3057\u307E\u3059\u3002\u65B0\u3057\u3044\u4EFB\u52D9\u5236\u5EA6\u306F\u4ECA\u5F8C\u8A2D\u8A08\u3055\u308C\u307E\u3059\u3002"
    koKR: "\uD604\uC7AC \uCC98\uB9AC\uD560 \uC0AC\uAC74\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      \uC0AC\uAC74\uC740 \uAE30\uC874 \uC870\uAC74\uACFC \uADC0\uD658 \uC808\uCC28\uB97C
      \uB530\uB974\uBA70, \uC0C8\uB85C\uC6B4 \uC784\uBB34 \uADDC\uCE59\uC740 \uCD94\uD6C4
      \uC124\uACC4\uB429\uB2C8\uB2E4."
  tradeLabel:
    zhCN: "\u4EA4\u6613"
    enUS: Trade
    zhTW: "\u4EA4\u6613"
    jaJP: "\u53D6\u5F15"
    koKR: "\uAC70\uB798"
